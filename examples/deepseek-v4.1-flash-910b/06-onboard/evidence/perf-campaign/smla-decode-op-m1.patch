+// =============Parser function====================
+bool SMLADInfoParser::HasAxis(const SMLADAxis &axis, const SMLADLayout &layout, const gert::Shape &shape) const
+{
+    const auto &layoutIt = SMLAD_LAYOUT_AXIS_MAP.find(layout);
+    if (layoutIt == SMLAD_LAYOUT_AXIS_MAP.end()) {
+        return false;
+    }
+
+    const std::vector<SMLADAxis> &axes = layoutIt->second;
+    const auto &axisIt = std::find(axes.begin(), axes.end(), axis);
+    if (axisIt == axes.end()) {
+        return false;
+    }
+    const auto &dimIt = SMLAD_LAYOUT_DIM_MAP.find(layout);
+    if (dimIt == SMLAD_LAYOUT_DIM_MAP.end() || dimIt->second != shape.GetDimNum()) {
+        return false;
+    }
+    return true;
+}
+
+size_t SMLADInfoParser::GetAxisIdx(const SMLADAxis &axis, const SMLADLayout &layout) const
+{
+    const std::vector<SMLADAxis> &axes = SMLAD_LAYOUT_AXIS_MAP.find(layout)->second;
+    const auto &axisIt = std::find(axes.begin(), axes.end(), axis);
+    return std::distance(axes.begin(), axisIt);
+}
+
+uint32_t SMLADInfoParser::GetAxisNum(const gert::Shape &shape, const SMLADAxis &axis, const SMLADLayout &layout) const
+{
+    return HasAxis(axis, layout, shape) ? shape.GetDim(GetAxisIdx(axis, layout)) : invalidDimValue_;
+}
