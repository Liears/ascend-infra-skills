+    int64_t qHeadDim = 0;
+    int64_t oriKvHeadDim = 0;
+    int64_t cmpKvHeadDim = 0;
+    int64_t oriBlockSize = 0;
+    int64_t cmpBlockSize = 0;
+    int64_t oriTopk = 0;
