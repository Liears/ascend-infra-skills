+// ------------------公共定义--------------------------
+struct SMLADTilingRequiredParaInfo {
+    const gert::CompileTimeTensorDesc *desc;
+    const gert::StorageShape *shape;
+};
+
+struct SMLADTilingOptionalParaInfo {
+    const gert::CompileTimeTensorDesc *desc;
+    const gert::Tensor *tensor;
+    const gert::StorageShape *shape;
+};
+
+enum class SMLADLayout : uint32_t {
+    BSND = 0,
+    TND = 1,
+    PA_BBND = 2
+};
+
+enum class SMLADAxis : uint32_t {
+    B = 0,
+    S = 1,
+    N = 2,
+    D = 3,
+    K = 3, // sparse_indices的K和key的D枚举值相同，表达相同位置, 最后一维
+    T = 5,
+    Bn = 6, // block number
+    Bs = 7  // block size
+};
+
+enum class SMLADTemplateMode : uint32_t {
+    SWA_TEMPLATE_MODE = 0,
+    HCA_TEMPLATE_MODE = 1,
+    CSA_TEMPLATE_MODE = 2,
+    ORI_SPARSE_TEMPLATE_MODE = 3,
+    ORI_CMP_SPARSE_TEMPLATE_MODE = 4
+};
+
