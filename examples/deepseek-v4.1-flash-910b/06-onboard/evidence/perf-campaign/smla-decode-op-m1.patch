+    bool isOri = true; // 判断当前块是在Ori部分还是Cmp部分
+    uint64_t s2StartPoint = 0;
+    int64_t cmpS2IdLimit = 0;
+    int32_t v0S2DealSize = 0;
+    int32_t v0S2Start = 0;
+};
+
+struct ConstInfo {
+    // CUBE与VEC核间同步的模式
+    static constexpr uint32_t SMLAD_SYNC_MODE2 = 2;
+    // BUFFER的字节数
