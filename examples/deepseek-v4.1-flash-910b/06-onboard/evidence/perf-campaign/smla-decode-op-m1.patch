+
+#if (__CCE_AICORE__ == 310)
+#define SMLAD_OP_IMPL(templateClass, tilingdataClass, ...) \
+    do { \
+        using CubeBlockType = \
+            typename std::conditional<g_coreType == AscendC::AIC, SMLADKernel::CSABlockCube<__VA_ARGS__>, \
+                                      SMLADKernel::CSABlockCubeDummy<__VA_ARGS__>>::type; \
+        using VecBlockType = \
+            typename std::conditional<g_coreType == AscendC::AIC, SMLADKernel::CSABlockVecDummy<__VA_ARGS__>, \
+                                      SMLADKernel::CSABlockVec<__VA_ARGS__>>::type; \
+        templateClass<CubeBlockType, VecBlockType> op; \
+        GET_TILING_DATA_WITH_STRUCT(tilingdataClass, tilingDataIn, tiling); \
+        const tilingdataClass *__restrict tilingData = &tilingDataIn; \
+        op.Init(query, oriKV, cmpKV, oriSparseIndices, cmpSparseIndices, oriBlockTable, cmpBlockTable, cuSeqlensQ, \
+                cuSeqlensOriKv, cuSeqlensCmpKv, seqUsedQ, seqUsedOriKV, seqUsedCmpKV, cmpResidualKV, oriTopkLength, \
+                cmpTopkLength, sinks, metadata, attentionOut, softmaxLse, user, tilingData); \
+        op.Process(); \
+    } while (0)
+#else
+#define SMLAD_OP_IMPL(templateClass, tilingdataClass, ...) \
+    do { \
+        templateClass<SMLADType<__VA_ARGS__>> op; \
+        GET_TILING_DATA_WITH_STRUCT(tilingdataClass, tiling_data_in, tiling); \
+        const tilingdataClass *__restrict tiling_data = &tiling_data_in; \
+        op.Init(query, oriKV, cmpKV, oriSparseIndices, cmpSparseIndices, oriBlockTable, cmpBlockTable, cuSeqlensQ, \
+                cuSeqlensOriKv, cuSeqlensCmpKv, seqUsedQ, seqUsedOriKV, seqUsedCmpKV, cmpResidualKV, oriTopkLength, \
+                cmpTopkLength, sinks, metadata, attentionOut, softmaxLse, user, tiling_data, tiling, &tPipe); \
+        op.Process(); \
+    } while (0)
+#endif
+
+template <int FLASH_DECODE, int LAYOUT_T, int KV_LAYOUT_T, int TEMPLATE_MODE, int SPLIT_G, int HEAD_RATIO_ONE,
+          int BATCH_CONSISTENCY, int IS_VEC_S2PHYADDR>
+__global__ __aicore__ void sparse_flash_mla_decode(
+    __gm__ uint8_t *query, __gm__ uint8_t *oriKV, __gm__ uint8_t *cmpKV, __gm__ uint8_t *oriSparseIndices,
+    __gm__ uint8_t *cmpSparseIndices, __gm__ uint8_t *oriBlockTable, __gm__ uint8_t *cmpBlockTable,
+    __gm__ uint8_t *cuSeqlensQ, __gm__ uint8_t *cuSeqlensOriKv, __gm__ uint8_t *cuSeqlensCmpKv,
+    __gm__ uint8_t *seqUsedQ, __gm__ uint8_t *seqUsedOriKV, __gm__ uint8_t *seqUsedCmpKV, __gm__ uint8_t *cmpResidualKV,
+    __gm__ uint8_t *oriTopkLength, __gm__ uint8_t *cmpTopkLength, __gm__ uint8_t *sinks, __gm__ uint8_t *metadata,
+    __gm__ uint8_t *attentionOut, __gm__ uint8_t *softmaxLse, __gm__ uint8_t *workspace, __gm__ uint8_t *tiling)
+{
+    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_2);
+    __gm__ uint8_t *user = GetUserWorkspace(workspace);
+
+#if (__CCE_AICORE__ == 310)
+    if constexpr (ORIG_DTYPE_Q == DT_FLOAT16 && ORIG_DTYPE_ORI_KV == DT_FLOAT16 && ORIG_DTYPE_ATTN_OUT == DT_FLOAT16) {
+        if constexpr (TEMPLATE_MODE == CSA_TEMPLATE || TEMPLATE_MODE == ORI_SPARSE_TEMPLATE ||
+                      TEMPLATE_MODE == ORI_CMP_SPARSE_TEMPLATE) {
+            SMLAD_OP_IMPL(SMLADKernel::SparseFlashMlaDecodeCsaKernel, SparseFlashMlaDecodeTilingData, half, half, float, half,
+                         FLASH_DECODE, static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T),
+                         static_cast<SMLADTemplateMode>(TEMPLATE_MODE), SPLIT_G, BATCH_CONSISTENCY, IS_VEC_S2PHYADDR);
+        } else {
+            SMLAD_OP_IMPL(SMLADKernel::SparseFlashMlaDecodeSwaKernel, SparseFlashMlaDecodeTilingData, half, half, float, half,
+                         FLASH_DECODE, static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T),
+                         static_cast<SMLADTemplateMode>(TEMPLATE_MODE), SPLIT_G, BATCH_CONSISTENCY, IS_VEC_S2PHYADDR);
+        }
+    }
+    if constexpr (ORIG_DTYPE_Q == DT_BF16 && ORIG_DTYPE_ORI_KV == DT_BF16 && ORIG_DTYPE_ATTN_OUT == DT_BF16) {
+        if constexpr (TEMPLATE_MODE == CSA_TEMPLATE || TEMPLATE_MODE == ORI_SPARSE_TEMPLATE ||
+                      TEMPLATE_MODE == ORI_CMP_SPARSE_TEMPLATE) {
+            SMLAD_OP_IMPL(SMLADKernel::SparseFlashMlaDecodeCsaKernel, SparseFlashMlaDecodeTilingData, bfloat16_t, bfloat16_t, float,
+                         bfloat16_t, FLASH_DECODE, static_cast<SMLAD_LAYOUT>(LAYOUT_T),
+                         static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), static_cast<SMLADTemplateMode>(TEMPLATE_MODE), SPLIT_G,
+                         BATCH_CONSISTENCY, IS_VEC_S2PHYADDR);
+        } else {
+            SMLAD_OP_IMPL(SMLADKernel::SparseFlashMlaDecodeSwaKernel, SparseFlashMlaDecodeTilingData, bfloat16_t, bfloat16_t, float,
+                         bfloat16_t, FLASH_DECODE, static_cast<SMLAD_LAYOUT>(LAYOUT_T),
+                         static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), static_cast<SMLADTemplateMode>(TEMPLATE_MODE), SPLIT_G,
+                         BATCH_CONSISTENCY, IS_VEC_S2PHYADDR);
+        }
+    }
+#else
+    TPipe tPipe;
+    if constexpr (ORIG_DTYPE_Q == DT_FLOAT16 && ORIG_DTYPE_ORI_KV == DT_FLOAT16 && ORIG_DTYPE_ATTN_OUT == DT_FLOAT16) {
+        if constexpr (TEMPLATE_MODE == CSA_TEMPLATE) {
+            SMLAD_OP_IMPL(SparseFlashMlaDecodeCsa, SparseFlashMlaDecodeTilingData, half, half, half, FLASH_DECODE,
+                         static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), TEMPLATE_MODE,
+                         static_cast<bool>(HEAD_RATIO_ONE));
+        } else {
+            SMLAD_OP_IMPL(SparseFlashMlaDecodeSwa, SparseFlashMlaDecodeTilingData, half, half, half, FLASH_DECODE,
+                         static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), TEMPLATE_MODE,
+                         static_cast<bool>(HEAD_RATIO_ONE));
+        }
+    }
+    if constexpr (ORIG_DTYPE_Q == DT_BF16 && ORIG_DTYPE_ORI_KV == DT_BF16 && ORIG_DTYPE_ATTN_OUT == DT_BF16) {
+        if constexpr (TEMPLATE_MODE == CSA_TEMPLATE) {
+            SMLAD_OP_IMPL(SparseFlashMlaDecodeCsa, SparseFlashMlaDecodeTilingData, bfloat16_t, bfloat16_t, bfloat16_t, FLASH_DECODE,
+                         static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), TEMPLATE_MODE,
+                         static_cast<bool>(HEAD_RATIO_ONE));
+        } else {
+            SMLAD_OP_IMPL(SparseFlashMlaDecodeSwa, SparseFlashMlaDecodeTilingData, bfloat16_t, bfloat16_t, bfloat16_t, FLASH_DECODE,
+                         static_cast<SMLAD_LAYOUT>(LAYOUT_T), static_cast<SMLAD_LAYOUT>(KV_LAYOUT_T), TEMPLATE_MODE,
+                         static_cast<bool>(HEAD_RATIO_ONE));
+        }
+    }
+#endif
+}
