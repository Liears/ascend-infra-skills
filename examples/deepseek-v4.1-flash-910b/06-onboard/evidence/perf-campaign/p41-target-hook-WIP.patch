+# ==== [V41-PARITY41] target 路径 PyTorch 替换 + 对拍模式 ====
+# 文件 /tmp/v41_smla41 内容 "1"=仅 torch 版; "parity"=双算对拍(前N次打印diff,返回官方值)
+_P41_STATE = {"mode": "", "mtime": -1.0, "checked": 0.0, "n": 0, "max": 8}
+
+
+def _p41_mode():
+    import os as _o
+    import time as _t
+    now = _t.monotonic()
+    c = _P41_STATE
+    if now - c["checked"] < 0.25:
+        return c["mode"]
+    c["checked"] = now
+    try:
+        st = _o.stat("/tmp/v41_smla41")
+        if st.st_mtime != c["mtime"]:
+            c["mtime"] = st.st_mtime
+            with open("/tmp/v41_smla41") as fh:
+                c["mode"] = fh.read().strip()
+            c["n"] = 0
+    except OSError:
+        c.update({"mode": "", "mtime": -1.0})
+    return c["mode"]
+
+
+def _torch_smla41(q, ori_kv, cmp_kv, ori_bt, cmp_bt, cu_q, seq_lens,
+                  cmp_seq_lens, cmp_idx, sinks, scale, win_left, ratio, block_size=128):
+    """PyTorch composition: ori causal sliding window + cmp top-k two-source attention."""
+    T, H, D = q.shape
+    R = seq_lens.shape[0]
+    q_lens = cu_q[1:] - cu_q[:R]
+    req = torch.repeat_interleave(torch.arange(R, device=q.device), q_lens)
+    base = (seq_lens - q_lens).long()
+    inreq = torch.arange(T, device=q.device) - cu_q[:R].long()[req]
+    pos = base[req] + inreq                                   # [T]
+
+    # --- ori causal sliding window [T, W] ---
+    Wd = win_left + 1
+    cols = pos[:, None] - win_left + torch.arange(Wd, device=q.device)[None, :]
+    ovalid = cols >= 0
+    cc = cols.clamp(min=0)
+    oblk = torch.div(cc, block_size, rounding_mode="floor").clamp(max=ori_bt.shape[1] - 1)
+    ooff = cc % block_size
+    oslot = torch.gather(ori_bt[req].long(), 1, oblk) * block_size + ooff
+    oflat = ori_kv.reshape(-1, D)
+    kv_o = oflat.index_select(0, oslot.reshape(-1)).reshape(T, Wd, D)
+
+    # --- cmp top-k [T, K]: idx = cmp pool logical pos -> cmp_bt map ---
+    K = cmp_idx.shape[-1]
+    cidx = cmp_idx.reshape(T, K).long()
+    cvalid = cidx >= 0
+    csafe = cidx.clamp(min=0)
+    cblk = torch.div(csafe, block_size, rounding_mode="floor").clamp(max=cmp_bt.shape[1] - 1)
+    coff = csafe % block_size
+    cslot = torch.gather(cmp_bt[req].long(), 1, cblk) * block_size + coff
+    # cmp causal: cmp pos c covers original tokens [c*ratio, c*ratio+ratio)
+    cpos0 = csafe * ratio
+    cvalid = cvalid & (cpos0 <= pos[:, None])
+    cflat = cmp_kv.reshape(-1, D)
+    kv_c = cflat.index_select(0, cslot.reshape(-1)).reshape(T, K, D)
+
+    # --- two-source concatenated attention ---
+    s_o = torch.bmm(q, kv_o.transpose(1, 2)) * scale
+    s_c = torch.bmm(q, kv_c.transpose(1, 2)) * scale
+    s = torch.cat([s_o, s_c], dim=2)
+    val = torch.cat([ovalid[:, None, :], cvalid[:, None, :]], dim=2)
+    s = s.masked_fill(~val, -1e4)
+    if sinks is not None:
+        s = s + sinks[None, :, None].to(s.dtype)
+    a = torch.softmax(s, dim=-1)
+    kv = torch.cat([kv_o, kv_c], dim=1)
+    return torch.bmm(a, kv)
