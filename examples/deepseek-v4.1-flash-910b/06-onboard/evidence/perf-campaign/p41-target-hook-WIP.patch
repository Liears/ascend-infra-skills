+# ==== [V41-PARITY41] target 路径 PyTorch 替换 + 对拍模式 ====
+# 文件 /tmp/v41_smla41 内容 "1"=仅 torch 版; "parity"=双算对拍(前N次打印diff,返回官方值)
+_P41_STATE = {"mode": "", "mtime": -1.0, "checked": 0.0, "n": 0, "max": 8}
+
+
+def _p41_mode():
+    import os as _o
+    import time as _t
+    now = _t.monotonic()
+    c = _P41_STATE
+    if now - c["checked"] < 0.25:
+        return c["mode"]
+    c["checked"] = now
+    try:
+        st = _o.stat("/tmp/v41_smla41")
+        if st.st_mtime != c["mtime"]:
+            c["mtime"] = st.st_mtime
+            with open("/tmp/v41_smla41") as fh:
+                c["mode"] = fh.read().strip()
+            c["n"] = 0
+    except OSError:
+        c.update({"mode": "", "mtime": -1.0})
+    return c["mode"]
+
+
+def _torch_smla41(q, ori_kv, cmp_kv, ori_bt, cmp_bt, cu_q, seq_lens,
+                  cmp_seq_lens, cmp_idx, sinks, scale, win_left, ratio, block_size=128):
+    """PyTorch composition (capture-friendly): ori causal sliding window +
+    optional cmp top-k source. Static-shape index math only; cmp_idx may be
+    None on compress_ratio-0 layers (sliding window only).
+    """
+    T, H, D = q.shape
+    R = seq_lens.shape[0]
+    dev = q.device
+
+    toks = torch.arange(T, device=dev)                          # [T]
+    cu_start = cu_q[:R].long()
+    cu_end = cu_q[1:R + 1].long()
+    # req-of-token via broadcast compare-sum (R x T, static) -- no repeat_interleave
+    req = (((toks[None, :] >= cu_start[:, None]) &
+            (toks[None, :] < cu_end[:, None])).to(torch.int64).sum(0) - 1).clamp(0, R - 1)
+    q_lens = cu_end - cu_start
+    base = (seq_lens.long() - q_lens)
+    pos = torch.gather(base, 0, req) + (toks - torch.gather(cu_start, 0, req))  # [T]
+
+    # --- ori causal sliding window [T, W] ---
+    Wd = win_left + 1
+    cols = pos[:, None] - win_left + torch.arange(Wd, device=dev)[None, :]
+    ovalid = cols >= 0
+    cc = cols.clamp(min=0)
+    oblk = torch.div(cc, block_size, rounding_mode="floor").clamp(max=ori_bt.shape[1] - 1)
+    ooff = cc - oblk * block_size
+    obt_v = torch.gather(torch.index_select(ori_bt.long(), 0, req), 1, oblk)   # [T, W]
+    ovalid = ovalid & (obt_v >= 0)
+    oslot = (obt_v * block_size + ooff).clamp(min=0)
+    kv_o = ori_kv.reshape(-1, D).index_select(
+        0, oslot.reshape(-1)).reshape(T, Wd, D)
+
+    s_o = torch.bmm(q, kv_o.transpose(1, 2)) * scale            # [T, H, W]
+
+    if cmp_idx is None:                                          # ratio-0 layers
+        s, val, kv_cat = s_o, ovalid[:, None, :], kv_o
+    else:
+        K = cmp_idx.shape[-1]
+        cidx = cmp_idx.reshape(T, K).long()
+        cvalid = cidx >= 0
+        csafe = cidx.clamp(min=0)
+        cblk = torch.div(csafe, block_size, rounding_mode="floor").clamp(max=cmp_bt.shape[1] - 1)
+        coff = csafe - cblk * block_size
+        cbt_v = torch.gather(torch.index_select(cmp_bt.long(), 0, req), 1, cblk)  # [T, K]
+        cvalid = cvalid & (cbt_v >= 0)
+        cslot = (cbt_v * block_size + coff).clamp(min=0)
+        # cmp causal: cmp pos c covers original tokens [c*ratio, c*ratio+ratio)
+        cvalid = cvalid & (csafe * ratio <= pos[:, None])
+        kv_c = cmp_kv.reshape(-1, D).index_select(
+            0, cslot.reshape(-1)).reshape(T, K, D)
+        s_c = torch.bmm(q, kv_c.transpose(1, 2)) * scale
+        s = torch.cat([s_o, s_c], dim=2)
+        val = torch.cat([ovalid[:, None, :], cvalid[:, None, :]], dim=2)
+        kv_cat = torch.cat([kv_o, kv_c], dim=1)
+
+    s = s.masked_fill(~val, -1e4)
+    if sinks is not None:
+        s = s + sinks[None, :, None].to(s.dtype)
+    a = torch.softmax(s, dim=-1)
+    return torch.bmm(a, kv_cat)
+
