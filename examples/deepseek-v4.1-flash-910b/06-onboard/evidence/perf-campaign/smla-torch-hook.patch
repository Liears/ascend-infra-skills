+# ==== [V41-SMLA-TORCH] PyTorch 版稀疏 MLA（draft/vision 路径；见 evidence/perf-campaign/P9）====
+# 实测：NPU graph 内 105µs vs aclnnSparseFlashMla 170µs（-38%），数值 bf16 级。
+# 开关：/tmp/v41_smla_torch 内容 "1" 开 / 删除关，0.25s 轮询（交替 A/B 用）。
+# 仅当 ori_sparse_indices 非空时生效（draft/vision 路径）；target 正常 decode 不传该参数，不受影响。
+_SMLA_TORCH_PATH = "/tmp/v41_smla_torch"
+_SMLA_TORCH_CACHE = {"on": False, "mtime": -1.0, "checked": 0.0}
+
+
+def _smla_torch_on():
+    import os as _o
+    import time as _t
+    now = _t.monotonic()
+    c = _SMLA_TORCH_CACHE
+    if now - c["checked"] < 0.25:
+        return c["on"]
+    c["checked"] = now
+    try:
+        st = _o.stat(_SMLA_TORCH_PATH)
+        if st.st_mtime != c["mtime"]:
+            c["mtime"] = st.st_mtime
+            with open(_SMLA_TORCH_PATH) as fh:
+                c["on"] = fh.read().strip() == "1"
+    except OSError:
+        c.update({"on": False, "mtime": -1.0})
+    return c["on"]
+
