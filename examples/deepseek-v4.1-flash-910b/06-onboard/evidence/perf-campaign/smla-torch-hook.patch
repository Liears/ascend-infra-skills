+def _torch_sparse_mla(q, kw):
+    """PyTorch 组合稀疏 MLA：gather + bmm + softmax + bmm（P9 §4）。
+
+    覆盖 swa-only 且带 ori_sparse_indices 的调用（draft 并行起草 / vision）。
+    -1 无效列用 -1e4 而非 -inf：padded 行（全 -1）softmax 保持有限值，避免 NaN
+    向下游传播；这些行的输出本就被丢弃。
+    """
+    kv = kw["ori_kv"]                                   # [NB, BLOCK, 1, D]
+    idx = kw["ori_sparse_indices"]                      # [T, 1, W] int32
+    T, H, D = q.shape
+    W = idx.shape[-1]
+    flat = kv.reshape(-1, D)
+    idx = idx.reshape(T, W).long()
+    valid = idx >= 0
+    safe = idx.clamp(min=0)
+    kvs = flat.index_select(0, safe.reshape(-1)).reshape(T, W, D)
+    s = torch.bmm(q, kvs.transpose(1, 2)) * kw["softmax_scale"]
+    s = s.masked_fill(~valid[:, None, :], -1e4)
+    sinks = kw.get("sinks")
+    if sinks is not None:
+        s = s + sinks[None, :, None].to(s.dtype)
+    a = torch.softmax(s, dim=-1)
+    return torch.bmm(a, kvs)
